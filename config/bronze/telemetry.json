{
  "version": "2.1.0",
  "kind": "BRONZE",
  "timezone": "UTC",
  "source": {
    "path": "datas/telemetry.csv",
    "format": "CSV",
    "encoding": "utf-8",
    "field_delimiter": ",",
    "row_delimiter": "\n",
    "has_header": true
  },
  "target": {
    "schema": "bronze",
    "table": "telemetry",
    "natural_key": [
      "machine_id",
      "timestamp"
    ]
  },
  "columns": [
    {
      "source_name": "machine_id",
      "target_name": "machine_id",
      "type": "IDENTIFIER",
      "silver_type": "TEXT",
      "nullable": false,
      "description": "Code machine (MACH-01...), référence machine.machine_code"
    },
    {
      "source_name": "timestamp",
      "target_name": "timestamp",
      "type": "TIMESTAMPTZ",
      "silver_type": "TIMESTAMPTZ",
      "nullable": false,
      "description": "Heure de la mesure, horloge UTC déclarée (ADR-003)"
    },
    {
      "source_name": "temperature_c",
      "target_name": "temperature_c",
      "type": "NUMBER",
      "silver_type": "DOUBLE PRECISION",
      "unit": "CELSIUS",
      "nullable": true
    },
    {
      "source_name": "pressure_bar",
      "target_name": "pressure_bar",
      "type": "NUMBER",
      "silver_type": "DOUBLE PRECISION",
      "unit": "BAR",
      "nullable": true
    },
    {
      "source_name": "voltage_mean_v",
      "target_name": "voltage_mean_v",
      "type": "NUMBER",
      "silver_type": "DOUBLE PRECISION",
      "unit": "VOLT",
      "nullable": false
    },
    {
      "source_name": "rotation_mean_rpm",
      "target_name": "rotation_mean_rpm",
      "type": "NUMBER",
      "silver_type": "DOUBLE PRECISION",
      "unit": "RPM",
      "nullable": true
    },
    {
      "source_name": "pieces_produced",
      "target_name": "pieces_produced",
      "type": "INTEGER",
      "silver_type": "INTEGER",
      "nullable": false,
      "description": "Pièces produites sur l'heure"
    }
  ]
}
